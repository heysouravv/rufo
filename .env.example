# Copy to .env and fill in real values. Never commit .env itself.

OPENAI_API_KEY=

# Used by control-plane/ (rufo-control-plane) -- the GCP project Cloud Run
# agent deployments are created in.
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Clerk application keys (control-plane/ auth). The publishable key may also
# be provided as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
